# ==============================================================================
# E2E Construction Management System - Production Environment Variables Example
# Safe template for production deployment (DO NOT COMMIT REAL SECRETS TO GIT)
# ==============================================================================

# Database Configuration (MySQL 8.0+)
DB_HOST=
DB_PORT=3306
DB_NAME=e2e_construction_db
DB_USERNAME=
DB_PASSWORD=
DB_USE_SSL=true

# Security & Authentication (minimum 256-bit HMAC secret)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Public Domains & URLs
FRONTEND_URL=
BACKEND_URL=

# CORS Allowed Origins (comma-separated list of allowed frontend domains)
APP_CORS_ALLOWED_ORIGINS=

# Application Server
SERVER_PORT=8080
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Production File Upload Directory (Mounted persistent volume path)
FILE_UPLOAD_DIR=uploads/machinery
